# Copy to `.env.local` for local development.
#
# NEXT_PUBLIC_API_BASE — where the Python backend runs.
#   Default: http://127.0.0.1:8787 (the local dev server).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787

# NEXT_PUBLIC_DEV_AUTH — set to 1 to let the sign-in screen complete locally.
#
# With it on, "Send one-time code" calls POST /api/dev/session, which sets the
# `archive_dev_email` cookie. That endpoint exists ONLY in
# backend/local_server.py — the deployed Worker has no equivalent — so leaving
# this unset is correct for anything that is not your laptop.
NEXT_PUBLIC_DEV_AUTH=1
