{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chat-archive-frontend",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",

  // The Worker answers on the archive's paths only. The root stays the
  // personal site (GitHub Pages) and /api/* stays the Python Worker.
  "workers_dev": false,
  "routes": [
    // One `chat-archives*` route, not `chat-archives` + `chat-archives/*`: a
    // route matches the whole URL including the query string and a pattern
    // cannot contain one, so an exact `chat-archives` never matched
    // /chat-archives?x=1 and that fell through to GitHub Pages (404). The
    // wildcard also catches /chat-archivesfoo and the like; worker.js hands
    // those back to the origin untouched.
    { "pattern": "akshayprabhakant.com/chat-archives*", "zone_name": "akshayprabhakant.com" },
    { "pattern": "akshayprabhakant.com/_next/*", "zone_name": "akshayprabhakant.com" },
    { "pattern": "akshayprabhakant.com/vendors/*", "zone_name": "akshayprabhakant.com" }
  ],

  // The Next.js static export (produced by `npm run build`). `run_worker_first`
  // so the story-permalink rewrite in worker.js always runs.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // The shared site parts (the theme, for now): every HTML page goes through
  // site-shell's compose() (akshayDev17/site-themes, shell/). site-shell must
  // be deployed before this binding is, or this deploy fails. worker.js fails
  // open: if site-shell is down, the page is served exactly as built.
  "services": [{ "binding": "SHELL", "service": "site-shell" }]
}
