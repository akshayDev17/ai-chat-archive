# Python
__pycache__/
*.py[cod]
.venv/
venv/
# Local Worker state: wrangler's cache and the --local D1 database. Per-machine,
# and the local database is rebuilt from migrations anyway.
.wrangler/

# Node / Next.js
node_modules/
*.tsbuildinfo

# Next build output. `.next` belongs to the dev server, `.next-build` to
# `npm run build:check`; keeping them separate is what stops a build from
# corrupting a running dev server.
.next/
.next-build/
out/

# Generated by Next on every dev/build run. Not ours to edit, and its one
# variable line is the path to the dist dir — so tracking it would commit a
# one-line flip every time the build dir changes.
next-env.d.ts

# secrets — Cloudflare docs: "The .dev.vars and .env files should not be
# committed to git. Add .dev.vars* and .env* to your project's .gitignore."
.env
.env*
# ...except the example, which exists to be committed. `.env*` would otherwise
# swallow it, so the one file whose whole job is documenting the others would
# never reach the repo.
!.env.local.example
.dev.vars
.dev.vars*

# misc
.DS_Store
*.log
*.db
*.sqlite3
